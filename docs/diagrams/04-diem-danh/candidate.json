  "cards": [
    {
      "dot": "emerald",
      "title": "Giảng viên điểm danh",
      "items": [
        "editable = lớp chưa published và buổi không sau hôm nay (canTakeAttendance)",
        "load(): chưa ghi thì mặc định present nếu editable, ngược lại notYet",
        "save() gọi saveAttendance → update trường attendance của sessions/{id}"
      ]
    },
    {
      "dot": "rose",
      "title": "Security Rules chặn ghi sai",
      "items": [
        "Chỉ giảng viên của lớp (classes/{classId}.lecturerId), lớp chưa published",
        "Chỉ sửa attendance; key thuộc studentIds; giá trị present hoặc absent",
        "Bị từ chối: 'Bạn không có quyền…', màn hình ở lại, vết chưa lưu còn nguyên"
      ]
    },
    {
      "dot": "amber",
      "title": "Sinh viên xem kết quả",
      "items": [
        "Đọc sessions theo studentIds array-contains uid; Rules cho đọc buổi có uid trong studentIds",
        "absentRate = absent / total, total gồm cả buổi chưa diễn ra",
        "isBanned khi absentRate > maxAbsentRate (0.2): màn hình hiện nhãn 'Cấm thi'"
      ]
    }
  ]
